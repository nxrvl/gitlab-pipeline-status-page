package templates

import (
    "gitlab-status/models"
    "strconv"
)

templ Runners(username string, loading bool, message string, gitLabURL string, projectsWithRunners []models.ProjectWithRunner) {
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8"/>
        <title>Runner Projects - GitLab Pipeline Status</title>
        <!-- Bootstrap 5 CSS -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
        <!-- Bootstrap Icons -->
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css"/>
        <!-- Bootstrap JS Bundle -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <!-- HTMX -->
        <script src="https://unpkg.com/htmx.org@1.9.0"></script>
        <style>
            .project-list {
                max-height: 600px;
                overflow-y: auto;
            }
            .search-box {
                position: sticky;
                top: 0;
                z-index: 100;
                background-color: white;
                padding: 10px 0;
            }
        </style>
    </head>
    <body>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" href="/">GitLab Pipeline Status</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" href="/">Status</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/settings">Settings</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active" aria-current="page" href="/runners">Runners</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle"></i> { username }
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                                <li><a class="dropdown-item" href="/logout">Logout</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <div class="container my-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>GitLab Runners</h1>
                <div>
                    <a href="/" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left"></i> Back to Status
                    </a>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Projects with Runners</h5>
                        <div>
                            <a href="/runners/refresh" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-arrow-clockwise"></i> Refresh Runners
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <p>Select the GitLab projects with runners that you want to monitor.</p>

                    if loading {
                        <div class="alert alert-info">
                            <h5 class="alert-heading"><i class="bi bi-info-circle"></i> Refreshing Runner Data</h5>
                            <p>{ message }</p>
                            <div class="progress mt-2 mb-3">
                                <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 100%"></div>
                            </div>
                            <p>This might take a while depending on the number of runners in your GitLab instance.</p>
                            <div class="mt-3">
                                <a href="/runners" class="btn btn-primary">
                                    <i class="bi bi-arrow-clockwise"></i> Check Status
                                </a>
                            </div>
                        </div>
                    } else if message != "" {
                        <div class="alert alert-info">
                            <h5 class="alert-heading"><i class="bi bi-info-circle"></i> Information</h5>
                            <p>{ message }</p>
                            if message != "Settings saved successfully!" {
                                <div class="mt-3">
                                    <a href="/runners/refresh" class="btn btn-primary">
                                        <i class="bi bi-arrow-clockwise"></i> Refresh Runners
                                    </a>
                                </div>
                            }
                        </div>
                    }

                    if len(projectsWithRunners) > 0 && !loading {
                        <form method="POST" action="/runners/save" id="runnerProjectsForm">
                            <!-- Search box -->
                            <div class="search-box mb-3">
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-search"></i>
                                    </span>
                                    <input type="text" class="form-control" id="searchInput" placeholder="Search for projects..." onkeyup="filterProjects()"/>
                                </div>
                            </div>

                            <div class="alert alert-info mb-3">
                                <i class="bi bi-info-circle"></i> Found { strconv.Itoa(len(projectsWithRunners)) } projects with GitLab runners. Select the ones you want to monitor.
                            </div>

                            <div class="project-list mb-3">
                                <table class="table table-striped table-hover">
                                    <thead>
                                        <tr>
                                            <th width="40px">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" id="selectAll" onclick="toggleAll()"/>
                                                </div>
                                            </th>
                                            <th>Project</th>
                                            <th>Path</th>
                                            <th>Runners</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="projectsTable">
                                        for _, project := range projectsWithRunners {
                                            <tr class="project-row">
                                                <td>
                                                    <div class="form-check">
                                                        <input class="form-check-input project-checkbox" type="checkbox" name="runner_projects" value={ strconv.Itoa(project.ID) } checked?={ project.IsMonitored }/>
                                                    </div>
                                                </td>
                                                <td>
                                                    <strong>{ project.Name }</strong>
                                                </td>
                                                <td>
                                                    <small class="text-muted">{ project.PathWithNamespace }</small>
                                                </td>
                                                <td>
                                                    <span class="badge bg-primary">{ strconv.Itoa(project.RunnerCount) } runner
                                                        if project.RunnerCount != 1 {
                                                            s
                                                        }
                                                    </span>
                                                </td>
                                                <td>
                                                    <a href={ templ.SafeURL(project.WebURL) } target="_blank" class="btn btn-sm btn-outline-secondary">
                                                        <i class="bi bi-box-arrow-up-right"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="mt-4 d-flex justify-content-between">
                                <div>
                                    <button type="button" class="btn btn-outline-primary" onclick="selectVisible()">
                                        <i class="bi bi-check-all"></i> Select Visible
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary" onclick="deselectAll()">
                                        <i class="bi bi-x-lg"></i> Deselect All
                                    </button>
                                </div>
                                <button type="submit" class="btn btn-primary">Save Selection</button>
                            </div>
                        </form>

                        <script>
                            function filterProjects() {
                                const input = document.getElementById('searchInput');
                                const filter = input.value.toLowerCase();
                                const table = document.getElementById('projectsTable');
                                const rows = table.getElementsByTagName('tr');

                                for (let i = 0; i < rows.length; i++) {
                                    const nameColumn = rows[i].getElementsByTagName('td')[1];
                                    const pathColumn = rows[i].getElementsByTagName('td')[2];
                                    if (nameColumn && pathColumn) {
                                        const nameText = nameColumn.textContent || nameColumn.innerText;
                                        const pathText = pathColumn.textContent || pathColumn.innerText;
                                        if (nameText.toLowerCase().indexOf(filter) > -1 ||
                                            pathText.toLowerCase().indexOf(filter) > -1) {
                                            rows[i].style.display = "";
                                        } else {
                                            rows[i].style.display = "none";
                                        }
                                    }
                                }
                            }

                            function toggleAll() {
                                const selectAllCheckbox = document.getElementById('selectAll');
                                const checkboxes = document.getElementsByClassName('project-checkbox');
                                const isChecked = selectAllCheckbox.checked;

                                for (let i = 0; i < checkboxes.length; i++) {
                                    const row = checkboxes[i].closest('tr');
                                    if (row.style.display !== 'none') {
                                        checkboxes[i].checked = isChecked;
                                    }
                                }
                            }

                            function selectVisible() {
                                const rows = document.getElementById('projectsTable').getElementsByTagName('tr');
                                for (let i = 0; i < rows.length; i++) {
                                    if (rows[i].style.display !== 'none') {
                                        const checkbox = rows[i].querySelector('.project-checkbox');
                                        if (checkbox) {
                                            checkbox.checked = true;
                                        }
                                    }
                                }
                            }

                            function deselectAll() {
                                const checkboxes = document.getElementsByClassName('project-checkbox');
                                for (let i = 0; i < checkboxes.length; i++) {
                                    checkboxes[i].checked = false;
                                }
                                document.getElementById('selectAll').checked = false;
                            }
                        </script>
                    }
                </div>
            </div>
        </div>
    </body>
    </html>
}